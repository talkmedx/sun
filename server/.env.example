NODE_ENV=development
PORT=5001
API_PREFIX=/api/v1

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=komals_makeovers
DB_CONNECTION_LIMIT=10

# JWT
JWT_ACCESS_SECRET=komals_makeovers_access_secret_change_in_production_2025
JWT_REFRESH_SECRET=komals_makeovers_refresh_secret_change_in_production_2025
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS
CLIENT_URL=http://localhost:3001

# Uploads
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# Google Drive — archive panel documents under:
#   komal's Makeover / {student name} {DD-MM-YYYY} / documents
# Connect from Settings after filling CLIENT_ID + CLIENT_SECRET.
# Sign in as vowvanity@gmail.com when Google asks.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5001/api/v1/settings/google-drive/callback
# Production (vanityvow.com):
# CLIENT_URL=https://vanityvow.com
# GOOGLE_DRIVE_REDIRECT_URI=https://vanityvow.com/api/v1/settings/google-drive/callback
GOOGLE_DRIVE_ROOT_FOLDER=komal's Makeover
GOOGLE_DRIVE_ACCOUNT_EMAIL=vowvanity@gmail.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
